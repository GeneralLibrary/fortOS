---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";
import { getDict } from "@/i18n";

const dict = getDict(Astro.currentLocale);
const { about } = dict;
---

<Layout title={about.title} description={about.desc}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{about.title}</Fragment>
      <Fragment slot="desc">{about.desc}</Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-16">
      <h2 class="font-bold text-3xl text-gray-800">{about.h2}</h2>
      <p class="text-lg leading-relaxed text-slate-500">{about.p1}</p>
      <p class="text-lg leading-relaxed text-slate-500">{about.p2}</p>
      <p class="text-lg leading-relaxed text-slate-500">{about.p3}</p>
    </div>

    <div class="mx-auto max-w-4xl mt-16">
      <h3 class="font-bold text-2xl text-gray-800">{about.listHeading}</h3>
      <ul class="grid md:grid-cols-2 gap-x-8 gap-y-3 mt-6">
        {about.list.map((item) => (
          <li class="flex items-start gap-3 text-gray-700">
            <Icon class="text-[#0071e3] w-5 h-5 mt-0.5 shrink-0" name="bx:check-circle" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mx-auto max-w-4xl mt-16">
      <h3 class="font-bold text-2xl text-gray-800">{about.quickStart}</h3>
      <pre
        class="mt-4 bg-slate-900 text-slate-100 rounded-lg p-5 text-sm leading-relaxed overflow-x-auto"><code>{about.quickStartCode}</code></pre>
    </div>
  </Container>
</Layout>
