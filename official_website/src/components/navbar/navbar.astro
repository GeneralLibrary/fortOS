---
import Container from "@/components/container.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDict } from "@/i18n";

const dict = getDict(Astro.currentLocale);
const isZh = Astro.currentLocale === "zh";

// Prefix paths with the locale when not the default locale
const localize = (path: string) => (isZh ? "/zh" + path : path);

const menuitems = [
  { title: dict.nav.features, path: localize("/#features") },
  { title: dict.nav.deploy, path: localize("/deploy") },
  { title: dict.nav.about, path: localize("/about") },
  { title: dict.nav.contact, path: localize("/contact") },
];

// Current path without the locale prefix, for building language-switch links.
let pathname = Astro.url.pathname.replace(/^\/zh(?=\/|$)/, "").replace(/^\/+/, "");

const localeLinks = [
  { code: "en", label: "English", url: getRelativeLocaleUrl("en", pathname) },
  { code: "zh", label: "中文", url: getRelativeLocaleUrl("zh", pathname) },
];
---

<div class="sticky top-0 z-40 bg-white/70 backdrop-blur-xl border-b border-slate-200/60">
  <Container>
    <header class="flex items-center justify-between h-14">
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <a href={isZh ? "/zh/" : "/"} class="flex items-center gap-2">
            <img
              src="/images/fortos-logo-nav.png"
              alt="FortOS logo"
              width="36"
              height="32"
              class="w-auto h-8 rounded-md"
            />
            <span class="text-[17px] font-semibold tracking-tight text-slate-900">FortOS</span>
          </a>
          <div class="block lg:hidden">
            <MenuIcon class="w-5 h-5 text-gray-800" />
          </div>
        </div>
        <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
          <ul class="flex flex-col lg:flex-row lg:gap-1">
            {menuitems.map((item) => (
              <li>
                <a
                  href={item.path}
                  class="flex lg:px-3 py-2 items-center text-sm text-gray-700 hover:text-[#2997ff]">
                  <span> {item.title}</span>
                </a>
              </li>
            ))}
            <li class="lg:hidden flex items-center mt-3 gap-4">
              <span class="text-gray-400 text-sm">{dict.nav.language}:</span>
              {localeLinks.map((l) => (
                <a
                  href={l.url}
                  class:list={[
                    "text-sm hover:text-[#2997ff]",
                    l.code === Astro.currentLocale
                      ? "font-semibold text-slate-900"
                      : "text-gray-500",
                  ]}>
                  {l.label}
                </a>
              ))}
            </li>
          </ul>
          <div class="lg:hidden flex items-center mt-3 gap-4">
            <a
              href="https://github.com/GeneralLibrary/fortOS"
              class="text-sm text-gray-700 hover:text-[#2997ff]"
              >{dict.common.github}</a
            >
          </div>
        </MenuItems>
      </Astronav>
      <div class="flex items-center gap-3">
        <div class="hidden lg:flex items-center gap-1 text-sm">
          {localeLinks.map((l) => (
            <a
              href={l.url}
              class:list={[
                "px-2.5 py-1 rounded-full transition",
                l.code === Astro.currentLocale
                  ? "bg-slate-100 text-slate-900 font-medium"
                  : "text-gray-500 hover:text-[#2997ff]",
              ]}
              aria-label={l.label}>
              {l.code === "zh" ? "中文" : "EN"}
            </a>
          ))}
        </div>
        <a
          href="https://github.com/GeneralLibrary/fortOS"
          target="_blank"
          rel="noopener"
          class="hidden lg:block text-sm text-gray-700 hover:text-[#2997ff]">
          {dict.common.github}
        </a>
      </div>
    </header>
  </Container>
</div>
