---
import { getDict } from "@/i18n";

const dict = getDict(Astro.currentLocale);
const videoTitle = "是的，开源了一个NAS系统fortOS";
---

<main class="pt-20 md:pt-28 pb-8 text-center">
  <div class="mx-auto max-w-4xl px-5">
    <span
      class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">
      {dict.hero.badge}
    </span>
    <h1
      class="mt-5 text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tight text-slate-900 leading-[1.05]">
      {dict.hero.title}
    </h1>
    <p class="mt-6 text-xl md:text-2xl text-slate-500 max-w-2xl mx-auto leading-relaxed">
      {dict.hero.subtitle}
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-x-8 gap-y-3 text-lg">
      <a
        href="https://github.com/GeneralLibrary/fortOS/releases"
        target="_blank"
        rel="noopener"
        class="text-[#2997ff] hover:underline decoration-[#2997ff] underline-offset-4">
        {dict.hero.ctaPrimary} <span class="font-medium">&gt;</span>
      </a>
      <a
        href="https://github.com/GeneralLibrary/fortOS"
        target="_blank"
        rel="noopener"
        class="text-[#2997ff] hover:underline decoration-[#2997ff] underline-offset-4">
        {dict.hero.ctaSecondary} <span class="font-medium">&gt;</span>
      </a>
    </div>
  </div>
  <div class="mt-14 md:mt-20 px-5">
    <div class="mx-auto max-w-3xl bg-black rounded-3xl overflow-hidden">
      <iframe
        src="https://player.bilibili.com/player.html?bvid=BV1uNuR6fETY&page=1&high_quality=1&danmaku=0&autoplay=0"
        class="w-full aspect-video block"
        title={videoTitle}
        loading="eager"
        scrolling="no"
        border="0"
        frameborder="no"
        framespacing="0"
        allowfullscreen="true"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      ></iframe>
    </div>
    <p class="text-center mt-4 text-slate-400 text-sm">
      <a
        href="https://www.bilibili.com/video/BV1uNuR6fETY"
        target="_blank"
        rel="noopener"
        class="text-[#2997ff] hover:underline decoration-[#2997ff] underline-offset-4">
        {dict.video.watchOnBilibili} <span class="font-medium">&gt;</span>
      </a>
    </p>
  </div>
</main>
