# =============================================================================
# GORT Debian 12 (Bookworm) Package Manifest
# =============================================================================
# This file defines ALL packages kept in the trimmed Debian 12 source tree.
# Categories:
#   [REQUIRED]  - Direct runtime dependency
#   [INDIRECT]  - Transitive / shared library dependency
#   [FUTURE]    - Planned for roadmap (v1.1, v1.2, v2.0)
#   [BUILD]     - ISO/build-time only
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE SYSTEM — Base Debian 12 minimal system
# -----------------------------------------------------------------------------
[REQUIRED] base-files
[REQUIRED] base-passwd
[REQUIRED] bash
[REQUIRED] coreutils
[REQUIRED] debianutils
[REQUIRED] dpkg
[REQUIRED] apt
[REQUIRED] ca-certificates
[REQUIRED] curl
[REQUIRED] openssh-server
[REQUIRED] sudo
[REQUIRED] systemd-sysv
[REQUIRED] systemd
[REQUIRED] udev
[INDIRECT] libpam-systemd
[INDIRECT] dbus
# dbus-broker conflicts with standard dbus-daemon

# -----------------------------------------------------------------------------
# 2. .NET 10 NATIVE DEPENDENCIES — Required by self-contained .NET apps
# -----------------------------------------------------------------------------
[REQUIRED] libicu72
[REQUIRED] libssl3
[REQUIRED] libunwind8
[REQUIRED] zlib1g
[REQUIRED] libstdc++6
[REQUIRED] libgcc-s1
[REQUIRED] libgssapi-krb5-2
[INDIRECT] libkrb5-3
[INDIRECT] libkrb5support0
[INDIRECT] libk5crypto3
[INDIRECT] libkeyutils1

# -----------------------------------------------------------------------------
# 3. NAS PROTOCOLS — File sharing services
# -----------------------------------------------------------------------------
# SMB/CIFS
[REQUIRED] samba
[REQUIRED] samba-common
[REQUIRED] samba-common-bin
[REQUIRED] samba-vfs-modules
[INDIRECT] libsmbclient
[INDIRECT] libwbclient0
[INDIRECT] samba-dsdb-modules
[INDIRECT] samba-libs
[INDIRECT] tdb-tools
[INDIRECT] libtalloc2
[INDIRECT] libtdb1
[INDIRECT] libtevent0
[INDIRECT] libldb2
[FUTURE] cifs-utils

# NFS
[REQUIRED] nfs-kernel-server
[REQUIRED] nfs-common
[INDIRECT] libnfsidmap1
[INDIRECT] rpcbind
[INDIRECT] keyutils
[INDIRECT] libevent-2.1-7

# FTP
[REQUIRED] vsftpd

# SFTP (future: explicit SFTP share support)
[FUTURE] openssh-sftp-server

# -----------------------------------------------------------------------------
# 4. STORAGE MANAGEMENT — Disk, RAID, filesystem toolchain
# -----------------------------------------------------------------------------
[REQUIRED] smartmontools
[REQUIRED] mdadm
[REQUIRED] parted
[REQUIRED] e2fsprogs
[REQUIRED] xfsprogs
[REQUIRED] btrfs-progs
[REQUIRED] util-linux
[INDIRECT] libparted2
[INDIRECT] libsmartcols1
[INDIRECT] libblkid1
[INDIRECT] libmount1
[INDIRECT] libuuid1
[INDIRECT] libfdisk1
[INDIRECT] fdisk
[INDIRECT] gdisk

# LVM (used by storage pool management)
[REQUIRED] lvm2
[INDIRECT] dmsetup
[INDIRECT] libdevmapper1.02.1
[INDIRECT] libaio1
[INDIRECT] thin-provisioning-tools

# Encryption (storage pool encryption)
[FUTURE] cryptsetup
[FUTURE] cryptsetup-bin
[FUTURE] libcryptsetup12

# ZFS (planned v1.1+)
[FUTURE] zfsutils-linux
[FUTURE] zfs-zed
[FUTURE] libzfs4linux
[FUTURE] libzpool5linux
[FUTURE] libnvpair3linux
[FUTURE] libuutil3linux

# -----------------------------------------------------------------------------
# 5. BACKUP & DATA PROTECTION
# -----------------------------------------------------------------------------
[REQUIRED] rsync
[REQUIRED] rclone
[INDIRECT] libacl1
[INDIRECT] libattr1
[INDIRECT] libpopt0
[INDIRECT] libxxhash0
[INDIRECT] libzstd1
[INDIRECT] liblz4-1

# BorgBackup (future dedup backup)
[FUTURE] borgbackup
[FUTURE] restic

# -----------------------------------------------------------------------------
