# dracut conflicts with initramfs-tools — Debian uses initramfs-tools by default

# -----------------------------------------------------------------------------
# 16. PYTHON (required by netplan, system tools)
# -----------------------------------------------------------------------------
[INDIRECT] python3
[INDIRECT] python3-minimal
[INDIRECT] python3.11
[INDIRECT] python3.11-minimal
[INDIRECT] python3-yaml
[INDIRECT] python3-dbus
[INDIRECT] python3-gi
[INDIRECT] python3-netifaces

# -----------------------------------------------------------------------------
# 17. PERL (required by some system scripts)
# -----------------------------------------------------------------------------
[INDIRECT] perl-base
[INDIRECT] perl

# -----------------------------------------------------------------------------
# EXPLICITLY EXCLUDED — Removed from standard Debian 12
# -----------------------------------------------------------------------------
# Desktop environments (GNOME, KDE, Xfce, etc.) — NOT needed for headless NAS
# LibreOffice, GIMP, Inkscape — NOT needed
# Games, multimedia players — NOT needed
# Printing (CUPS) — NOT needed
# Bluetooth stack — NOT needed
# Sound systems (PulseAudio, ALSA, PipeWire) — NOT needed
# Mail servers (Postfix, Exim) — NOT needed
# Web browsers (Firefox, Chromium) — NOT needed
# Development tools (gcc, g++, make) — NOT needed at runtime
# TeX/LaTeX documentation systems — NOT needed
# X11/Wayland display servers — NOT needed
# Accessibility tools — NOT needed
# Unnecessary locales (keep en_US.UTF-8, zh_CN.UTF-8 only)
# Unnecessary firmware (keep only common server NIC/storage firmware)
