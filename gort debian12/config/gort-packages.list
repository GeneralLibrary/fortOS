# -----------------------------------------------------------------------------
[REQUIRED] nftables
[REQUIRED] iptables
[REQUIRED] iproute2
[REQUIRED] netplan.io
[REQUIRED] network-manager
[INDIRECT] libnftnl11
[INDIRECT] libnftables1
[INDIRECT] libip4tc2
[INDIRECT] libip6tc2
[INDIRECT] libxtables12
[INDIRECT] libnl-3-200
[INDIRECT] libnl-route-3-200
[INDIRECT] libnl-genl-3-200
[INDIRECT] libnm0
[INDIRECT] libndp0
[INDIRECT] libteamdctl0
[INDIRECT] dnsmasq-base
[INDIRECT] wireless-regdb
