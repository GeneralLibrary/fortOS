<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FortOS.Core\FortOS.Core.csproj" />
    <ProjectReference Include="..\FortOS.Security\FortOS.Security.csproj" />
    <ProjectReference Include="..\FortOS.Modules\FortOS.Modules.csproj" />
    <ProjectReference Include="..\FortOS.Modules.Storage\FortOS.Modules.Storage.csproj" />
    <ProjectReference Include="..\FortOS.Modules.Share\FortOS.Modules.Share.csproj" />
    <ProjectReference Include="..\FortOS.Modules.Network\FortOS.Modules.Network.csproj" />
    <ProjectReference Include="..\FortOS.Modules.Agent\FortOS.Modules.Agent.csproj" />
    <ProjectReference Include="..\FortOS.Modules.Backup\FortOS.Modules.Backup.csproj" />
    <ProjectReference Include="..\FortOS.Modules.Update\FortOS.Modules.Update.csproj" />
    <ProjectReference Include="..\FortOS.Agent\FortOS.Agent.csproj" />
    <ProjectReference Include="..\FortOS.ServiceBus\FortOS.ServiceBus.csproj" />
    <ProjectReference Include="..\FortOS.Observability\FortOS.Observability.csproj" />
    <ProjectReference Include="..\FortOS.Platform\FortOS.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\protos\*.proto" GrpcServices="Both" ProtoRoot="..\..\protos" />
  </ItemGroup>

</Project>
