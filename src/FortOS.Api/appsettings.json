{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [ { "Name": "Console" } ]
  },
  "security": {
    "require_auth": true,
    "issuer": "nas://local",
    "token": { "lifetime_minutes": 480 }
  },
  "dashboard": { "enabled": false },
  "rateLimit": { "defaultPerMinute": 100, "loginPerMinute": 5 },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5000", "Protocols": "Http1" },
      "Grpc": { "Url": "http://0.0.0.0:5001", "Protocols": "Http2" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
