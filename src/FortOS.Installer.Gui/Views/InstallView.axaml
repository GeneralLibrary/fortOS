<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FortOS.Installer.Gui.ViewModels"
             x:DataType="vm:InstallViewModel"
             x:Class="FortOS.Installer.Gui.Views.InstallView">    <DockPanel>
        <!-- Planning view: summary + warning + begin installation (hidden once execution starts) -->
        <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16"
                    IsVisible="{Binding IsPlanning}">
            <TextBlock Text="{Binding L[confirm.title]}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace"
                       FontSize="14" LineHeight="24"/>
            <TextBlock Text="{Binding L[confirm.warning]}"
                       Foreground="#FF6B6B" FontWeight="Bold"/>
            <Button Content="{Binding L[confirm.begin]}"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BeginInstallCommand}"
                    Classes="Primary" FontSize="16" Padding="24,10" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Progress view: phase + progress bar + failure actions -->
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16"
                    IsVisible="{Binding !IsPlanning}">
            <TextBlock Text="{Binding PhaseText}" FontSize="16" FontWeight="Bold"/>
            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="14"/>
            <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsFailed}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" TextWrapping="Wrap" MaxWidth="520"/>
                <Button Content="{Binding L[install.retry]}" Command="{Binding RetryCommand}"/>
                <Button Content="{Binding L[install.reboot]}" Command="{Binding RebootCommand}"/>
            </StackPanel>
        </StackPanel>
        <Border Background="#15181D" CornerRadius="6" Padding="12">
            <ListBox ItemsSource="{Binding LogLines}" FontFamily="Cascadia Mono,Consolas,monospace"
                     FontSize="12" Background="Transparent"/>
        </Border>
    </DockPanel>
</UserControl>
