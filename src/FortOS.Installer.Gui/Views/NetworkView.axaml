<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FortOS.Installer.Gui.ViewModels"
             x:DataType="vm:NetworkViewModel"
             x:Class="FortOS.Installer.Gui.Views.NetworkView">
    <StackPanel Spacing="16" MaxWidth="640" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding L[network.hostname]}"/>
                <TextBox Text="{Binding Hostname}" MinWidth="220"/>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding L[network.mode]}"/>
                <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding Mode}" MinWidth="140"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowStaticFields}">
            <TextBlock Text="{Binding L[network.address]}"/>
            <TextBox Text="{Binding Address}" MinWidth="280"/>
            <TextBlock Text="{Binding L[network.gateway]}"/>
            <TextBox Text="{Binding Gateway}" MinWidth="280"/>
            <TextBlock Text="{Binding L[network.dns]}"/>
            <TextBox Text="{Binding Dns}" MinWidth="280"/>
        </StackPanel>

        <!-- WiFi:扫描、选择、连接(连接成功后经 DHCP 获取地址) -->
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding L[network.wifi.title]}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="{Binding L[network.wifi.scan]}" Command="{Binding ScanWifiCommand}"
                        IsVisible="{Binding !IsWifiBusy}" Padding="12,4"/>
            </StackPanel>
            <ComboBox ItemsSource="{Binding WifiSsids}" SelectedItem="{Binding SelectedSsid}" MinWidth="280"
                      PlaceholderText="{Binding L[network.wifi.ssid]}"/>
            <TextBox Text="{Binding WifiPassword}" MinWidth="280" PasswordChar="●"
                     Watermark="{Binding L[network.wifi.password]}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{Binding L[network.wifi.connect]}" Command="{Binding ConnectWifiCommand}"
                        IsEnabled="{Binding CanConnectWifi}" Padding="12,4"/>
                <TextBlock Text="{Binding WifiStatus}" Foreground="#9BA6B5" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding L[network.hint]}"
                   Foreground="#9BA6B5" FontSize="12"/>
    </StackPanel>
</UserControl>
