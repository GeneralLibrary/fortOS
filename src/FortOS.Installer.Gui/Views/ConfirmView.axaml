<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FortOS.Installer.Gui.ViewModels"
             x:DataType="vm:ConfirmViewModel"
             x:Class="FortOS.Installer.Gui.Views.ConfirmView">
    <StackPanel Spacing="20" MaxWidth="640" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding L[confirm.title]}" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="14" LineHeight="24"/>
        <TextBlock Text="{Binding L[confirm.warning]}"
                   Foreground="#FF6B6B" FontWeight="Bold"/>
        <Button Content="{Binding L[confirm.begin]}"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BeginInstallCommand}"
                Classes="Primary" FontSize="16" Padding="24,10" HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>
