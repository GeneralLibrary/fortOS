<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GORT.Core\GORT.Core.csproj" />
    <ProjectReference Include="..\GORT.Security\GORT.Security.csproj" />
    <ProjectReference Include="..\GORT.Modules\GORT.Modules.csproj" />
    <ProjectReference Include="..\GORT.Modules.Storage\GORT.Modules.Storage.csproj" />
    <ProjectReference Include="..\GORT.Modules.Share\GORT.Modules.Share.csproj" />
    <ProjectReference Include="..\GORT.Modules.Network\GORT.Modules.Network.csproj" />
    <ProjectReference Include="..\GORT.Modules.Agent\GORT.Modules.Agent.csproj" />
    <ProjectReference Include="..\GORT.Modules.Backup\GORT.Modules.Backup.csproj" />
    <ProjectReference Include="..\GORT.Modules.Update\GORT.Modules.Update.csproj" />
    <ProjectReference Include="..\GORT.Agent\GORT.Agent.csproj" />
    <ProjectReference Include="..\GORT.ServiceBus\GORT.ServiceBus.csproj" />
    <ProjectReference Include="..\GORT.Observability\GORT.Observability.csproj" />
    <ProjectReference Include="..\GORT.Platform\GORT.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\protos\*.proto" GrpcServices="Both" ProtoRoot="..\..\protos" />
  </ItemGroup>

</Project>
