#!/bin/sh
set -eu

# -------------------------------------------------------------------------
# GORT runtime hook — runs inside the live-build chroot after package
# installation. Sets up GORT binaries, systemd units, and trims non-
# essential services.
# -------------------------------------------------------------------------

echo "=== GORT Runtime Hook ==="

# --- 1. GORT binaries ---
chmod 0755 /opt/gort/api/GORT.Api /opt/gort/cli/GORT.Cli
ln -sf /opt/gort/cli/GORT.Cli /usr/local/bin/gort

# --- 2. Enable GORT-required services ---
echo "Enabling GORT services..."
systemctl enable docker.service
systemctl enable containerd.service
systemctl enable smbd.service
systemctl enable nmbd.service
systemctl enable nfs-server.service
systemctl enable nfs-mountd.service
systemctl enable rpcbind.service
systemctl enable vsftpd.service
systemctl enable ssh.service
systemctl enable NetworkManager.service
systemctl enable nut-monitor.service 2>/dev/null || true
systemctl enable gort.service

# --- 3. GORT tmpfiles ---
systemd-tmpfiles --create /etc/tmpfiles.d/gort.conf

# --- 4. Trim non-essential services ---
# Only keep what GORT directly or indirectly needs.
if [ -x /opt/gort/scripts/trim-services.sh ]; then
    echo "Running service trimming..."
    /opt/gort/scripts/trim-services.sh
    rm /opt/gort/scripts/trim-services.sh
else
    echo "WARNING: trim-services.sh not found. Services will not be trimmed."
fi

# --- 5. Disable graphical target ---
# GORT is headless — force multi-user.target.
ln -sf /lib/systemd/system/multi-user.target /etc/systemd/system/default.target
rm -f /etc/systemd/system/default.target
ln -sf /lib/systemd/system/multi-user.target /etc/systemd/system/default.target

echo "=== GORT Runtime Hook Complete ==="
