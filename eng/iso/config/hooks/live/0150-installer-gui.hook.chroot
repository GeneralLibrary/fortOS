#!/bin/sh
# -------------------------------------------------------------------------
# FortOS installer kiosk hook — 启用图形安装向导服务并赋予启动脚本执行位
# (includes.chroot 从 Windows checkout 复制时权限可能丢失)。
# 注意:同一 rootfs 也是安装后的目标系统,ChrootStep 会在安装时禁用
# fortos-installer.service(见 FortOS.Installer.Core Steps/ChrootStep.cs)。
# -------------------------------------------------------------------------
set -eu

echo "=== FortOS Installer GUI Hook ==="

# 启动脚本执行位。
chmod 0755 /opt/fortos/installer/gui/fortos-installer-kiosk.sh \
    /opt/fortos/installer/gui/installer-session.sh \
    /opt/fortos/installer/gui/fortos-installer-diag.sh

# headless CLI 进 PATH(串口/自动化/E2E 路径使用 `fortos-installer` 命令)。
if [ -x /opt/fortos/installer/cli/fortos-installer ]; then
    ln -sf /opt/fortos/installer/cli/fortos-installer /usr/local/bin/fortos-installer
else
    echo "WARNING: /opt/fortos/installer/cli/fortos-installer not found" >&2
fi

# 0100 hook 的服务裁剪可能裁掉图形栈依赖——断言关键组件存在,
# 缺失时报警(CI 构建据此发现问题)。
for component in /usr/bin/Xorg /usr/bin/openbox \
    /opt/fortos/installer/gui/fortos-installer-gui; do
    if [ ! -e "${component}" ]; then
        echo "error: expected installer component missing: ${component}" >&2
        exit 1
    fi
done

# Avalonia 安装器运行时库断言:fortos-installer-gui 在启动时 dlopen 这些
# X11/Skia 库,缺任意一个都会静默崩溃(表现为 live 环境无 GUI)。
# 与 package-lists/fortos.list.chroot 中的条目一一对应;缺失直接失败,
# 让构建日志指出具体库,而不是发布后开机黑屏。
required_libs="
libICE.so.6 libSM.so.6 libX11.so.6 libXcomposite.so.1 libXcursor.so.1
libXdamage.so.1 libXext.so.6 libXfixes.so.3 libXi.so.6 libXinerama.so.1
libXrandr.so.2 libXrender.so.1 libXtst.so.6 libxkbcommon.so.0
libxkbcommon-x11.so.0 libfontconfig.so.1 libfreetype.so.6
libGL.so.1 libEGL.so.1
"
missing_libs=""
for lib in ${required_libs}; do
    if ! ldconfig -p 2>/dev/null | grep -q "${lib} "; then
        missing_libs="${missing_libs} ${lib}"
    fi
done
if [ -n "${missing_libs}" ]; then
    echo "error: missing Avalonia installer runtime libraries:${missing_libs}" >&2
    echo "       add the corresponding packages to package-lists/fortos.list.chroot" >&2
    exit 1
fi

systemctl enable fortos-installer.service
# CI 冒烟诊断服务(QEMU 引导测试经 ttyS1 断言 GUI 状态)。
systemctl enable fortos-installer-diag.service

echo "=== FortOS Installer GUI Hook Complete ==="
