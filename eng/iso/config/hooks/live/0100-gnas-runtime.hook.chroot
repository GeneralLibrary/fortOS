#!/bin/sh
set -eu

# -------------------------------------------------------------------------
# GNAS runtime hook — runs inside the live-build chroot after package
# installation. Sets up GNAS binaries, systemd units, and trims non-
# essential services.
# -------------------------------------------------------------------------

echo "=== GNAS Runtime Hook ==="

# --- 1. GNAS binaries ---
chmod 0755 /opt/gnas/api/GNAS.Api /opt/gnas/cli/GNAS.Cli
ln -sf /opt/gnas/cli/GNAS.Cli /usr/local/bin/gnas

# --- 2. Enable GNAS-required services ---
echo "Enabling GNAS services..."
systemctl enable docker.service
systemctl enable containerd.service
systemctl enable smbd.service
systemctl enable nmbd.service
systemctl enable nfs-server.service
systemctl enable nfs-mountd.service
systemctl enable rpcbind.service
systemctl enable vsftpd.service
systemctl enable ssh.service
systemctl enable NetworkManager.service
systemctl enable nut-monitor.service 2>/dev/null || true
systemctl enable gnas.service

# --- 3. GNAS tmpfiles ---
systemd-tmpfiles --create /etc/tmpfiles.d/gnas.conf

# --- 4. Trim non-essential services ---
# Only keep what GNAS directly or indirectly needs.
if [ -x /opt/gnas/scripts/trim-services.sh ]; then
    echo "Running service trimming..."
    /opt/gnas/scripts/trim-services.sh
    rm /opt/gnas/scripts/trim-services.sh
else
    echo "WARNING: trim-services.sh not found. Services will not be trimmed."
fi

# --- 5. Disable graphical target ---
# GNAS is headless — force multi-user.target.
ln -sf /lib/systemd/system/multi-user.target /etc/systemd/system/default.target
rm -f /etc/systemd/system/default.target
ln -sf /lib/systemd/system/multi-user.target /etc/systemd/system/default.target

echo "=== GNAS Runtime Hook Complete ==="
