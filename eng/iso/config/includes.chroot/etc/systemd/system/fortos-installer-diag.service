[Unit]
Description=FortOS Installer GUI diagnostics (CI smoke test)
# 在安装器服务启动后输出 GUI 状态到 ttyS1,QEMU 引导测试据此断言
# Avalonia 向导已拉起;真实硬件上无 ttyS1 时静默退出,无副作用。
After=fortos-installer.service

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/opt/fortos/installer/gui/fortos-installer-diag.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
