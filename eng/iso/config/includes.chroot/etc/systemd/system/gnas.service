[Unit]
Description=GNAS management service
Documentation=https://github.com/GeneralLibrary/gnas
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/gnas/gnas.env
WorkingDirectory=/opt/gnas/api
ExecStart=/opt/gnas/api/GNAS.Api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027

[Install]
WantedBy=multi-user.target
