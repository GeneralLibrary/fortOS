[Unit]
Description=GORT management service
Documentation=https://github.com/GeneralLibrary/gort
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/gort/gort.env
WorkingDirectory=/opt/gort/api
ExecStart=/opt/gort/api/GORT.Api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027

[Install]
WantedBy=multi-user.target
