# FortOS host services and storage/network administration tools.
ca-certificates
curl
openssh-server
sudo
systemd-sysv

# Native dependencies required by self-contained .NET applications.
libicu72
libssl3
libunwind8
zlib1g
libstdc++6
libgcc-s1
libgssapi-krb5-2

# NAS protocol and disk toolchain used by the Linux platform adapters.
samba
nfs-kernel-server
vsftpd
smartmontools
mdadm
parted
e2fsprogs
xfsprogs
btrfs-progs
util-linux
rsync
nftables
iptables
iproute2
netplan.io
network-manager
nut-client
rclone

# Live environment. The graphical Debian installer is supplied separately by
# live-build, so a full desktop environment is intentionally not embedded.
live-boot
live-config
live-config-systemd

# ---------------------------------------------------------------------------
# FortOS graphical installer (design: docs/installer-design.md §3.2/§8).
# Xorg + Openbox kiosk stack; installed-system copies inherit these, which is
# an accepted size trade-off (M4 may trim them post-install).
# ---------------------------------------------------------------------------
xorg
openbox
xinit
xauth
x11-xkb-utils
fonts-noto-cjk
gdisk
dosfstools
cryptsetup

# Avalonia 12 GUI runtime libraries (X11 backend + Skia rendering). The
# installer binary dlopens these at startup — missing any one crashes the
# wizard silently, so they are also asserted at build time by the
# 0150-installer-gui hook (missing → build fails with the exact library).
# 运行期还会继续加载 Mesa/XCB/DRM 族库(见 CI 本地 strace 结果),否则
# fortos-installer-gui 会在 xinit 会话里立即退出并触发 fortos-installer
# systemd 重启循环。
libice6
libsm6
libx11-6
libx11-xcb1
libxcb1
libxcb-glx0
libxcb-shm0
libxcb-dri3-0
libxcb-present0
libxcb-xfixes0
libxcb-randr0
libxcb-sync1
libxcomposite1
libxcursor1
libxdamage1
libdrm2
libxext6
libxfixes3
libxi6
libxinerama1
libxrandr2
libxrender1
libxtst6
libxkbcommon0
libxkbcommon-x11-0
libfontconfig1
libfreetype6
libgl1
libgl1-mesa-dri
libegl1

# Bootloader toolchain used by the installer's BootloaderStep (design §5.5).
# grub-install executes from the live environment; signed shim + grub modules
# keep the Secure Boot chain intact.
# NOTE: the arch-specific package names (grub-efi-amd64-*/grub-pc-bin vs
# grub-efi-arm64-*) live in fortos-grub-<arch>.list.chroot, selected by the
# build scripts via ARCHITECTURE.
