# GORT host services and storage/network administration tools.
ca-certificates
curl
openssh-server
sudo
systemd-sysv

# Native dependencies required by self-contained .NET applications.
libicu72
libssl3
libunwind8
zlib1g
libstdc++6
libgcc-s1
libgssapi-krb5-2

# NAS protocol and disk toolchain used by the Linux platform adapters.
samba
nfs-kernel-server
vsftpd
smartmontools
mdadm
parted
e2fsprogs
xfsprogs
btrfs-progs
util-linux
rsync
nftables
iptables
iproute2
netplan.io
network-manager
nut-client
rclone

# Live environment. The graphical Debian installer is supplied separately by
# live-build, so a full desktop environment is intentionally not embedded.
live-boot
live-config
live-config-systemd
